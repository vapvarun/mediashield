node_modules/
# Commit the Composer RUNTIME closure so a fresh clone activates without `composer install`.
# Dev-only deps (phpunit, phpstan, wpcs, …) stay ignored; `composer install --no-dev` leaves
# exactly these dirs, which is also what the dist build ships.
vendor/*
!vendor/autoload.php
!vendor/composer/
!vendor/woocommerce/
!vendor/easy-digital-downloads/
# symfony/yaml — runtime dep used by the architecture-invariants gate; must ship
# so a fresh clone can run `composer arch-checks` without `composer install`.
!vendor/symfony/
dist/
*.zip

# wp-plugin-onboard scratch dir
.claude-tmp/

# Journey runs — local artifacts written by bin/run-journeys.sh; the specs in
# audit/journeys/ are the contract, the per-run output under journey-runs/ is not.
audit/journey-runs/

# PHPUnit caches.
.phpunit.cache/
.phpunit.result.cache
