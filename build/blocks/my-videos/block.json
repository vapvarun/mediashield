{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mediashield/my-videos",
  "version": "1.4.1",
  "title": "MediaShield My Videos",
  "category": "media",
  "icon": "playlist-video",
  "description": "The videos the logged-in member has watched, with their progress and a Resume link.",
  "keywords": [
    "video",
    "progress",
    "mediashield",
    "watch",
    "history"
  ],
  "textdomain": "mediashield",
  "attributes": {
    "browseUrl": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    },
    "html": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}