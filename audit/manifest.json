    { "name": "mediashield_trusted_ip_headers", "type": "filter", "args": "$headers", "where": "includes/Access/SessionManager.php:165, includes/REST/StreamController.php:340", "consumed_by": null },
    { "name": "mediashield_watermark_config", "type": "filter", "args": "$watermark_config, $video_id, $user_id", "where": "includes/Player/Watermark.php:225", "consumed_by": "PRO Watermark\\AdvancedConfig" },
    { "name": "mediashield_settings_response", "type": "filter", "args": "$settings", "where": "includes/REST/SettingsController.php:142", "consumed_by": "PRO Admin\\ProSettings, PRO Admin\\DRMSettings (extends settings shape with PRO fields)" },
    { "name": "mediashield_settings_update", "type": "filter", "args": "$data", "where": "includes/REST/SettingsController.php:169", "consumed_by": "PRO Admin\\ProSettings, PRO Admin\\DRMSettings (saves PRO fields)" },
    { "name": "mediashield_upload_drivers", "type": "filter", "args": "$drivers", "where": "includes/Upload/UploadManager.php:48", "consumed_by": "PRO Upload\\Drivers (Bunny, YouTube, Vimeo, Wistia)" },
