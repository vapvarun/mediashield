    { "key": "privacy.exporter", "class": "MediaShield\\Privacy\\PrivacyExporter", "added": "1.0.0" },
    { "key": "privacy.eraser", "class": "MediaShield\\Privacy\\PrivacyEraser", "added": "1.0.0" },
    { "key": "access.session_manager", "class": "MediaShield\\Access\\SessionManager", "added": "1.0.0" },
    { "key": "access.access_control", "class": "MediaShield\\Access\\AccessControl", "added": "1.0.0" },
    { "key": "admin.menu", "class": "MediaShield\\Admin\\Menu", "added": "1.0.0" },
    { "key": "admin.setup_wizard", "class": "MediaShield\\Admin\\SetupWizard", "added": "1.0.0" },
    { "key": "tags.manager", "class": "MediaShield\\Tags\\TagManager", "added": "1.0.0" },
