    { "name": "mediashield_needs_shaka", "type": "action", "args": "(none)", "where": "includes/Block/VideoBlock.php:62, includes/Block/PlaylistBlock.php:200", "consumed_by": "Frontend Assets enqueue (loads shaka-player when needed)" },
    { "name": "mediashield_before_player", "type": "action", "args": "$video_id", "where": "includes/Player/PlayerWrapper.php:72", "consumed_by": null },
    { "name": "mediashield_after_player", "type": "action", "args": "$video_id", "where": "includes/Player/PlayerWrapper.php:169", "consumed_by": null },

    { "name": "mediashield_enqueue_frontend", "type": "filter", "args": "$enqueue (bool)", "where": "includes/Core/Assets.php:71", "consumed_by": null },
    { "name": "mediashield_can_watch", "type": "filter", "args": "$result, $video_id, $user_id", "where": "includes/Access/AccessControl.php:64", "consumed_by": "PRO Access\\RoleAccess, PRO Access\\EmailGate, PRO LMS adapters" },
