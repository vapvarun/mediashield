{
  "$schema": "https://wpmediaverse.com/schemas/wp-plugin-manifest-v1.json",
  "plugin": {
    "slug": "mediashield",
    "name": "MediaShield",
    "version": "1.0.0",
    "namespace": "MediaShield",
    "main_file": "mediashield.php",
    "text_domain": "mediashield",
    "extends": null,
    "extension_hook_consumed": null,
    "extension_hook_fired": "mediashield_loaded"
  },
  "rest": {
    "namespace": "mediashield/v1",
    "endpoints": [
      { "route": "/tags", "methods": ["GET", "POST"], "handler": "TagController::list_tags|create_tag", "permission": "manage_options", "purpose": "List all tags / create tag" },
      { "route": "/tags/(?P<id>\\d+)", "methods": ["GET", "PUT", "DELETE"], "handler": "TagController::get_tag|update_tag|delete_tag", "permission": "manage_options", "purpose": "Single tag CRUD" },
      { "route": "/videos/(?P<video_id>\\d+)/tags", "methods": ["GET", "POST"], "handler": "TagController::get_video_tags|assign_tag", "permission": "manage_options", "purpose": "Tags for a video / assign tag" },
      { "route": "/videos/(?P<video_id>\\d+)/tags/(?P<tag_id>\\d+)", "methods": ["DELETE"], "handler": "TagController::remove_tag", "permission": "manage_options", "purpose": "Remove tag from video" },
      { "route": "/session/start", "methods": ["POST"], "handler": "SessionController::start_session", "permission": "is_user_logged_in", "purpose": "Start watch session, returns HMAC token" },
      { "route": "/session/heartbeat", "methods": ["POST"], "handler": "SessionController::heartbeat", "permission": "is_user_logged_in", "purpose": "Update session position + progress (every 30s)" },
      { "route": "/session/end", "methods": ["POST"], "handler": "SessionController::end_session", "permission": "is_user_logged_in", "purpose": "End session, finalize stats" },
      { "route": "/session/revoke-user", "methods": ["POST"], "handler": "SessionController::revoke_user", "permission": "manage_options", "purpose": "Kill all active sessions for a user" },
      { "route": "/playlists/(?P<playlist_id>\\d+)/items", "methods": ["GET", "POST"], "handler": "PlaylistController::list_items|add_item", "permission": "manage_options", "purpose": "List/add playlist items" },
      { "route": "/playlists/(?P<playlist_id>\\d+)/items/(?P<item_id>\\d+)", "methods": ["DELETE"], "handler": "PlaylistController::remove_item", "permission": "manage_options", "purpose": "Remove playlist item" },
      { "route": "/playlists/(?P<playlist_id>\\d+)/items/reorder", "methods": ["POST"], "handler": "PlaylistController::reorder_items", "permission": "manage_options", "purpose": "Reorder playlist items" },
      { "route": "/upload/init", "methods": ["POST"], "handler": "UploadController::init_upload", "permission": "manage_options", "purpose": "Initialize upload (chunked supported)" },
      { "route": "/upload/status/(?P<upload_id>[a-zA-Z0-9._-]+)", "methods": ["GET"], "handler": "UploadController::get_status", "permission": "manage_options", "purpose": "Check upload progress" },
      { "route": "/settings", "methods": ["GET", "PUT"], "handler": "SettingsController::get_settings|update_settings", "permission": "manage_options", "purpose": "Retrieve / update plugin settings (filterable via mediashield_settings_response, mediashield_settings_update)" },
      { "route": "/analytics/overview", "methods": ["GET"], "handler": "AnalyticsController::get_overview", "permission": "manage_options", "purpose": "Dashboard summary stats" },
      { "route": "/videos/(?P<id>\\d+)/stats", "methods": ["GET"], "handler": "AnalyticsController::get_video_stats", "permission": "manage_options", "purpose": "Per-video statistics" },
      { "route": "/analytics/milestones", "methods": ["GET"], "handler": "AnalyticsController::get_milestones", "permission": "manage_options", "purpose": "Milestone completion data" },
      { "route": "/analytics/users", "methods": ["GET"], "handler": "AnalyticsController::get_users", "permission": "manage_options", "purpose": "User engagement list" },
      { "route": "/analytics/users/(?P<user_id>\\d+)", "methods": ["GET"], "handler": "AnalyticsController::get_user_detail", "permission": "manage_options", "purpose": "Single user detail" },
      { "route": "/analytics/my-videos", "methods": ["GET"], "handler": "AnalyticsController::get_my_videos", "permission": "is_user_logged_in", "purpose": "Current user's watched videos" },
      { "route": "/stream/(?P<video_id>\\d+)", "methods": ["GET"], "handler": "StreamController::stream_video", "permission": "AccessControl::can_watch (mediashield_can_watch filter)", "purpose": "Stream a self-hosted video file with permission gate" },
      { "route": "/protection/devtools-event", "methods": ["POST"], "handler": "ProtectionController::log_devtools_event", "permission": "is_user_logged_in", "purpose": "Log a devtools-detection event for analytics + rate limiting" }
    ]
  },
  "ajax": [],
  "admin_pages": [
    { "title": "MediaShield", "slug": "mediashield", "parent": "<top-level>", "capability": "manage_options", "source": "includes/Admin/Menu.php (add_menu_page)" },
    { "title": "Setup", "slug": "mediashield-setup", "parent": "mediashield", "capability": "manage_options", "source": "includes/Admin/SetupWizard.php (add_submenu_page)" }
  ],
  "settings": [
    { "key": "ms_enabled", "group": "ms_settings", "type": "bool", "default": true, "controls": "Master enable/disable toggle" },
    { "key": "ms_default_protection", "group": "ms_settings", "type": "string", "default": "standard", "controls": "Default protection level (standard|drm)" },
    { "key": "ms_require_login", "group": "ms_settings", "type": "bool", "default": false, "controls": "Require login to view protected videos" },
    { "key": "ms_watermark_opacity", "group": "ms_settings", "type": "float", "default": 0.5, "controls": "Watermark overlay opacity (0-1)" },
    { "key": "ms_watermark_color", "group": "ms_settings", "type": "string", "default": "#ffffff", "controls": "Watermark text color (hex)" },
    { "key": "ms_watermark_swap_interval", "group": "ms_settings", "type": "int", "default": 30, "controls": "Watermark position-swap interval (seconds)" },
    { "key": "ms_allowed_domains", "group": "ms_settings", "type": "array", "default": [], "controls": "Allowed embed domains (anti-leech)" },
    { "key": "ms_max_concurrent_streams", "group": "ms_settings", "type": "int", "default": 2, "controls": "Max concurrent stream sessions per user" },
    { "key": "ms_custom_url_patterns", "group": "ms_settings", "type": "array", "default": [], "controls": "Custom URL patterns to detect+wrap as videos" },
    { "key": "ms_show_badge", "group": "ms_settings", "type": "bool", "default": true, "controls": "Show 'Protected by MediaShield' badge on player" },
    { "key": "ms_max_upload_size", "group": "ms_settings", "type": "int", "default": 524288000, "controls": "Max upload size in bytes (default 500MB)" },
    { "key": "ms_login_overlay_text", "group": "ms_settings", "type": "string", "default": "", "controls": "Text for the login-required overlay" },
    { "key": "ms_login_button_text", "group": "ms_settings", "type": "string", "default": "Log in", "controls": "Login overlay CTA button text" },
    { "key": "ms_access_denied_text", "group": "ms_settings", "type": "string", "default": "", "controls": "Text shown when role-based access is denied" },
    { "key": "ms_block_right_click", "group": "ms_settings", "type": "bool", "default": true, "controls": "Disable right-click context menu on protected players" },
    { "key": "ms_block_keyboard", "group": "ms_settings", "type": "bool", "default": true, "controls": "Block keyboard shortcuts on protected players" },
    { "key": "ms_detect_devtools", "group": "ms_settings", "type": "bool", "default": true, "controls": "Detect when devtools are open" },
    { "key": "ms_pause_on_devtools", "group": "ms_settings", "type": "bool", "default": true, "controls": "Pause playback if devtools detected" },
    { "key": "ms_devtools_title", "group": "ms_settings", "type": "string", "default": "", "controls": "Title shown to user when devtools are detected" },
    { "key": "ms_devtools_message", "group": "ms_settings", "type": "string", "default": "", "controls": "Message body shown when devtools detected" },
    { "key": "ms_milestones", "group": "ms_settings", "type": "array", "default": [25, 50, 75, 100], "controls": "Milestone percentages to track" },
    { "key": "ms_db_version", "group": "ms_internal", "type": "int", "default": 1, "controls": "Internal DB schema version (managed by Migrator)" },
    { "key": "ms_archive_old_sessions", "group": "ms_settings", "type": "bool", "default": true, "controls": "Archive watch sessions older than N days (cron-driven)" },
    { "key": "ms_cleanup_inactive_sessions", "group": "ms_settings", "type": "bool", "default": true, "controls": "Clean up sessions whose last_heartbeat is older than the inactivity threshold" }
  ],
  "shortcodes": [
    { "tag": "mediashield", "handler": "Block\\Shortcode::render", "attrs": ["id"] },
    { "tag": "mediashield_my_videos", "handler": "Block\\MyVideosBlock::shortcode_render", "attrs": [] }
  ],
  "blocks": [
    { "name": "mediashield/video", "render": "Block\\VideoBlock::render", "interactivity": false, "source": "src/blocks/video/", "build": "build/blocks/video/" },
    { "name": "mediashield/playlist", "render": "Block\\PlaylistBlock::render", "interactivity": false, "source": "src/blocks/playlist/", "build": "build/blocks/playlist/" },
    { "name": "mediashield/my-videos", "render": "Block\\MyVideosBlock::render", "interactivity": false, "source": "src/blocks/my-videos/", "build": "build/blocks/my-videos/" }
  ],
  "post_types": [
    { "slug": "mediashield_video", "rest_base": "mediashield-videos", "supports": ["title", "editor", "thumbnail", "custom-fields"], "purpose": "Protected video item with platform metadata", "registered_in": "includes/CPT/VideoPostType.php" },
    { "slug": "mediashield_playlist", "rest_base": "mediashield-playlists", "supports": ["title", "editor", "thumbnail"], "purpose": "Playlist of videos with autoplay/countdown/loop/shuffle controls", "registered_in": "includes/CPT/PlaylistPostType.php" }
  ],
  "taxonomies": [],
  "tables": [
    { "name": "{prefix}ms_tags", "purpose": "Tag dictionary (id, name, slug, description, created_by, created_at)", "schema_in": "includes/DB/Schema.php:35" },
    { "name": "{prefix}ms_video_tags", "purpose": "Video↔tag junction (video_id, tag_id unique pair)", "schema_in": "includes/DB/Schema.php:49" },
    { "name": "{prefix}ms_watch_sessions", "purpose": "Active + recent watch sessions with HMAC tokens, IP, device, position, progress", "schema_in": "includes/DB/Schema.php:60" },
    { "name": "{prefix}ms_watch_sessions_archive", "purpose": "Archive table for sessions older than retention threshold (mirrors ms_watch_sessions schema)", "schema_in": "includes/DB/Schema.php (dynamic)" },
    { "name": "{prefix}ms_milestones", "purpose": "Milestone completion records (video, user, milestone_pct, reached_at)", "schema_in": "includes/DB/Schema.php:95" },
    { "name": "{prefix}ms_playlist_items", "purpose": "Ordered playlist items (playlist_id, video_id, sort_order)", "schema_in": "includes/DB/Schema.php:110" }
  ],
  "capabilities": [],
