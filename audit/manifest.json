    { "key": "db.schema", "class": "MediaShield\\DB\\Schema", "added": "1.0.0" },
    { "key": "rest.stream", "class": "MediaShield\\REST\\StreamController", "added": "1.0.0" },
    { "key": "rest.protection", "class": "MediaShield\\REST\\ProtectionController", "added": "1.0.0" },
    { "key": "rest.analytics", "class": "MediaShield\\REST\\AnalyticsController", "added": "1.0.0" },
    { "key": "rest.playlist", "class": "MediaShield\\REST\\PlaylistController", "added": "1.0.0" },
    { "key": "rest.upload", "class": "MediaShield\\REST\\UploadController", "added": "1.0.0" },
