  "hooks_fired": [
    {
      "name": "mediashield_loaded",
      "type": "action",
      "args": "(none)",
      "where": "includes/Core/Plugin.php:110",
      "consumed_by": "NOBODY — zero subscribers. PRO does NOT consume this; it boots on plugins_loaded:20 + a defined('MEDIASHIELD_VERSION') guard (mediashield-pro.php:85). Kept as a public extension point for third-party add-ons, but load order does not depend on it."
    },
    {
      "name": "mediashield_concurrent_limit_reached",
      "type": "action",
      "args": "$user_id, $video_id, $active_count, $max_concurrent",
      "where": "includes/Access/SessionManager.php:107",
      "consumed_by": null
    },
    {
      "name": "mediashield_session_started",
      "type": "action",
      "args": "$session_id, $video_id, $user_id, $ip",
      "where": "includes/Access/SessionManager.php:176",
      "consumed_by": null
    },
    {
      "name": "mediashield_session_ended",
      "type": "action",
      "args": "$session_id, $video_id, $user_id",
      "where": "includes/REST/SessionController.php:278",
      "consumed_by": null
    },
    {
      "name": "mediashield_user_access_revoked",
      "type": "action",
      "args": "$user_id, $count",
      "where": "includes/REST/SessionController.php:313",
      "consumed_by": null
    },
    {
      "name": "mediashield_milestone_reached",
      "type": "action",
      "args": "$user_id, $video_id, $pct, $session_id",
      "where": "includes/Milestones/MilestoneTracker.php:126",
      "consumed_by": "PRO Modules\\Milestones\\AdvancedActions"
    },
    {
      "name": "mediashield_milestone_{pct}",
      "type": "action",
      "args": "$user_id, $video_id (dynamic — pct 25/50/75/100)",
      "where": "includes/Milestones/MilestoneTracker.php:138",
      "consumed_by": "PRO Modules\\Milestones\\AdvancedActions"
    },
    {
      "name": "mediashield_devtools_detected",
      "type": "action",
      "args": "$context",
      "where": "includes/REST/ProtectionController.php:154",
      "consumed_by": null
    },
    {
      "name": "mediashield_upload_complete",
      "type": "action",
      "args": "$video_id, $driver_name, $result",
      "where": "includes/Upload/UploadManager.php:148",
      "consumed_by": null
    },
    {
      "name": "mediashield_needs_shaka",
      "type": "action",
      "args": "(none)",
      "where": "includes/Block/VideoBlock.php:62, includes/Block/PlaylistBlock.php:200",
      "consumed_by": "Frontend Assets enqueue (loads shaka-player when needed)"
    },
    {
      "name": "mediashield_before_player",
      "type": "action",
      "args": "$video_id",
      "where": "includes/Player/PlayerWrapper.php:72",
      "consumed_by": null
    },
    {
      "name": "mediashield_after_player",
      "type": "action",
      "args": "$video_id",
      "where": "includes/Player/PlayerWrapper.php:169",
      "consumed_by": null
    },
    {
      "name": "mediashield_enqueue_frontend",
      "type": "filter",
      "args": "$enqueue (bool)",
      "where": "includes/Core/Assets.php:71",
      "consumed_by": null
    },
    {
      "name": "mediashield_can_watch",
