    { "key": "rest.settings", "class": "MediaShield\\REST\\SettingsController", "added": "1.0.0" },
    { "key": "rest.tag", "class": "MediaShield\\REST\\TagController", "added": "1.0.0" },
    { "key": "upload.manager", "class": "MediaShield\\Upload\\UploadManager", "added": "1.0.0" },
    { "key": "cron.cleanup", "class": "MediaShield\\Cron\\Cleanup", "added": "1.0.0" },
    { "key": "block.shortcode", "class": "MediaShield\\Block\\Shortcode", "added": "1.0.0" },
    { "key": "block.playlist", "class": "MediaShield\\Block\\PlaylistBlock", "added": "1.0.0" },
    { "key": "block.my_videos", "class": "MediaShield\\Block\\MyVideosBlock", "added": "1.0.0" }
  ],
  "hooks_fired": [
    { "name": "mediashield_loaded", "type": "action", "args": "(none)", "where": "includes/Core/Plugin.php:110", "consumed_by": "PRO bootstrap (mediashield-pro)" },
    { "name": "mediashield_concurrent_limit_reached", "type": "action", "args": "$user_id, $video_id, $active_count, $max_concurrent", "where": "includes/Access/SessionManager.php:107", "consumed_by": null },
    { "name": "mediashield_session_started", "type": "action", "args": "$session_id, $video_id, $user_id, $ip", "where": "includes/Access/SessionManager.php:176", "consumed_by": null },
    { "name": "mediashield_session_ended", "type": "action", "args": "$session_id, $video_id, $user_id", "where": "includes/REST/SessionController.php:278", "consumed_by": null },
